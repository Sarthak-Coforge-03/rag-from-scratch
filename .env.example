# Copy to .env and fill in the values marked REQUIRED. Every other value shown is the default.

# --- Source documents ---
POLICY_DOCS_DIR=data/policies
# Files larger than this (bytes) are skipped when chunking (5 MB)
MAX_DOC_BYTES=5000000

# --- Index folders (SQL + vectors per index) ---
INDEX_ROOT=indexes
INDEX_NAME=default

# --- Chunking (used when 02_chunk.py creates a new index) ---
# Strategy: token | structural
CHUNK_STRATEGY=token
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Embedding (used when 03_embed.py --create makes a vector folder) ---
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# --- Vector store ---
VECTOR_STORE=chroma
VECTOR_COLLECTION=policy_chunks

# --- Retrieval ---
# Strategy: vector | keyword | hybrid
RETRIEVER=hybrid
TOP_K=5

# --- Reranking ---
RERANK_PROVIDER=cross-encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# How many retrieved candidates the reranker re-scores before keeping TOP_K
RERANK_CANDIDATES=20

# --- LLM (answer generation) ---
LLM_PROVIDER=anthropic-foundry
# On Foundry this is the deployment name; the "-fast" deployment turns on fast mode
LLM_MODEL=claude-opus-5-5-fast
# REQUIRED: your Foundry endpoint, e.g. https://<resource>.services.ai.azure.com/anthropic
LLM_ENDPOINT=
# Thinking tokens count toward this cap, so keep it well above the answer length
LLM_MAX_TOKENS=16000
# How hard the model thinks: low | medium | high | xhigh | max
LLM_EFFORT=low
# REQUIRED: your Foundry API key (only in .env, never in .env.example)
ANTHROPIC_FOUNDRY_API_KEY=

# --- Optional ---
# Skip the Hugging Face Hub check once the models are downloaded (quieter, works offline)
# HF_HUB_OFFLINE=1
